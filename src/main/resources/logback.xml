<configuration>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${user.home}/.kiro-control-panel/logs/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${user.home}/.kiro-control-panel/logs/app.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- No console appender: this is a tray-resident GUI app, not a CLI tool.
         Launching from a terminal should return control to the prompt, not
         stream logs there. Use "View Logs..." in the Help menu, or read
         ${user.home}/.kiro-control-panel/logs/app.log directly. -->
    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
